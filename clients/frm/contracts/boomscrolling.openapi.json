{
  "openapi": "3.2.1",
  "info": {
    "title": "BoomScrolling account API",
    "version": "1.0.0",
    "description": "Internal Sites-authenticated API. Supplied drafts do not generate, approve or publish. Sites owns authentication; raw identity headers are not a public credential."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "x-sites-authentication": {
    "required": true,
    "mode": "managed-ingress",
    "description": "Use the existing Sites sign-in session. No standalone cookie name, bearer-token flow or public identity-header credential is defined by this API."
  },
  "paths": {
    "/api/v1/capabilities": {
      "get": {
        "operationId": "get_capabilities",
        "summary": "Read BoomScrolling access",
        "description": "Read current workspace access and provider allowance without a provider call. Sign-in, product access, X permission and funding are separate. No purchase links or private owner data.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current account-scoped result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "schemaVersion": {
                      "const": 1
                    },
                    "access": {
                      "type": "object",
                      "properties": {
                        "mode": {
                          "enum": [
                            "free",
                            "paid"
                          ]
                        },
                        "entitled": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "mode",
                        "entitled"
                      ],
                      "additionalProperties": false
                    },
                    "operations": {
                      "type": "object",
                      "properties": {
                        "get_workspace_context": {
                          "type": "boolean"
                        },
                        "propose_draft": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "get_workspace_context",
                        "propose_draft"
                      ],
                      "additionalProperties": false
                    },
                    "funding": {
                      "type": "object",
                      "properties": {
                        "suppliedDraft": {
                          "const": "caller_runtime"
                        },
                        "hostedGeneration": {
                          "const": false
                        }
                      },
                      "required": [
                        "suppliedDraft",
                        "hostedGeneration"
                      ],
                      "additionalProperties": false
                    },
                    "following": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "available": {
                              "const": false
                            },
                            "reason": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "available",
                            "reason"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "available": {
                              "type": "boolean"
                            },
                            "reason": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "postReadsRemaining": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "costRemainingMicroUsd": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "periodEnd": {
                              "type": "integer"
                            }
                          },
                          "required": [
                            "available",
                            "reason",
                            "postReadsRemaining",
                            "costRemainingMicroUsd",
                            "periodEnd"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "publication": {
                      "type": "object",
                      "properties": {
                        "available": {
                          "const": false
                        },
                        "reason": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "available",
                        "reason"
                      ],
                      "additionalProperties": false
                    },
                    "delegatedOAuth": {
                      "type": "boolean"
                    },
                    "requestId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": [
                    "schemaVersion",
                    "access",
                    "operations",
                    "funding",
                    "following",
                    "publication",
                    "delegatedOAuth"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },

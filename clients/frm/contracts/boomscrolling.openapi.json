    "/api/v1/draft-proposals": {
      "post": {
        "operationId": "propose_draft",
        "summary": "Save an unapproved response",
        "description": "Save supplied text as a new unapproved draft for an exact saved-source version. Reuse requestId only for the same proposal. Never generates text, approves or posts; review the draft in BoomScrolling. Same-origin JSON required for browser writes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "requestId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "expectedRevision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "postId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "sourceVersion": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "form": {
                    "type": "string",
                    "enum": [
                      "reply",
                      "quote"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16000
                  }
                },
                "required": [
                  "requestId",
                  "expectedRevision",
                  "postId",
                  "sourceVersion",
                  "form",
                  "text"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current account-scoped result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "revision": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "draft": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "postId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "form": {
                              "enum": [
                                "reply",
                                "quote"
                              ]
                            },
                            "text": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 16000
                            },
                            "status": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "postId",
                            "form",
                            "text",
                            "status"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "duplicate": {
                      "type": "boolean"
                    },
                    "reviewRequired": {
                      "const": true
                    },
                    "funding": {
                      "const": "caller_runtime"
                    },
                    "requestId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": [
                    "revision",
                    "draft",
                    "duplicate",
                    "reviewRequired",
                    "funding"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Request rejected; inspect code and error before retrying.",
            "content": {

    "/api/v1/kit/workspace/manifest": {
      "get": {
        "operationId": "kit_get_export_manifest",
        "summary": "Prepare the deterministic workspace ZIP manifest for your existing paid account. Returns a versioned authenticated download path and content hash; no file upload, generation, local sync or installation.",
        "security": [
          {
            "SitesManagedIdentity": []
          }
        ],
        "parameters": [
          {
            "name": "snapshot_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^kit_[a-f0-9]{64}$"
            },
            "description": "Optional exact snapshot returned by context or manifest. A newer snapshot returns 409."
          }
        ],
        "responses": {
          "200": {
            "description": "Account-scoped read. No provider call or compute reservation.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "snapshot_id": {
                      "type": "string",
                      "pattern": "^kit_[a-f0-9]{64}$"
                    },
                    "revisions": {
                      "type": "object",
                      "required": [
                        "profile",
                        "brain",
                        "work"
                      ],
                      "properties": {
                        "profile": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "brain": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "work": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "additionalProperties": false
                    },
                    "read_only": {
                      "const": true
                    },
                    "funding": {
                      "const": "caller_runtime"
                    },
                    "content_type": {
                      "const": "application/zip"
                    },
                    "filename": {
                      "const": "my-business-starter.zip"
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "download_path": {
                      "type": "string",
                      "pattern": "^/(?:api/v1/kit|agent/kit)/workspace/export\\?snapshot_id=kit_[a-f0-9]{64}$"
                    },
                    "review_status": {
                      "enum": [
                        "owner_reviewed",
                        "not_reviewed"
                      ]
                    },
                    "local_files": {
                      "const": "snapshot_only_no_sync"
                    }
                  },
                  "required": [
                    "snapshot_id",
                    "revisions",
                    "read_only",
                    "funding",
                    "content_type",
                    "filename",
                    "bytes",
                    "sha256",
                    "download_path",
                    "review_status",
                    "local_files"
                  ],
                  "additionalProperties": false
                }
              }
            }

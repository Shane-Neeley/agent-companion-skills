{
  "openapi": "3.2.1",
  "info": {
    "title": "Fort Rock Agent Setup Kit internal API",
    "version": "1.0.0",
    "description": "Sites-ingress account-scoped read/export API. Current implementation does not accept raw external OAuth tokens or caller identity headers. Use existing Sites browser sign-in or its connected MCP service. This contract grants no publication, hosted compute or local filesystem authority."
  },
  "servers": [
    {
      "url": "https://fortrockmedia.com"
    }
  ],
  "paths": {
    "/api/v1/kit/capabilities": {
      "get": {
        "operationId": "kit_get_capabilities",
        "summary": "Read your Kit access and available context/export operations. No provider call, purchase, upgrade or compute grant.",
        "security": [
          {
            "SitesManagedIdentity": []
          }
        ],
        "responses": {
          "200": {
            "description": "Account-scoped read. No provider call or compute reservation.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "product": {
                      "const": "agent_setup_kit"
                    },
                    "product_access": {
                      "type": "boolean"
                    },
                    "auth_method": {
                      "enum": [
                        "sites_ingress",
                        "delegated_oauth"
                      ]
                    },
                    "operations": {
                      "type": "object",
                      "properties": {
                        "workspace_read": {
                          "type": "boolean"
                        },
                        "workspace_export": {
                          "type": "boolean"
                        },
                        "hosted_compute": {
                          "const": false
                        }
                      },
                      "required": [
                        "workspace_read",
                        "workspace_export",
                        "hosted_compute"
                      ],
                      "additionalProperties": false
                    },
                    "funding": {
                      "type": "object",
                      "properties": {
                        "context_and_export": {
                          "const": "no_model_request"
                        },
                        "reasoning": {
                          "const": "caller_runtime"
                        },
                        "hosted_compute": {
                          "const": "not_exposed"
                        }
                      },
                      "required": [
                        "context_and_export",
                        "reasoning",
                        "hosted_compute"
                      ],
                      "additionalProperties": false
                    },
                    "reason": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "retryable": {
                      "const": false
                    }
                  },
                  "required": [
                    "product",
                    "product_access",
                    "auth_method",
                    "operations",
                    "funding",
                    "reason",
                    "retryable"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments or workspace not ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "message",
                        "requestId",
                        "retryable"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "requestId": {
                          "type": "string",
